@using Microsoft.EntityFrameworkCore
@using SchoolBlogProject
@using SchoolBlogProject.Models
@inject SchoolBlogProject.Data.ApplicationDbContext DbContext
@{
    SiteSettings? siteSettings = await DbContext.SiteSettings
        .AsNoTracking()
        .OrderBy(settings => settings.SiteSettingsId)
        .Include(settings => settings.MediaContact)
        .Include(settings => settings.ColorScheme)
        .Include(settings => settings.OffSiteLinks)
        .FirstOrDefaultAsync();

    string schoolName = string.IsNullOrWhiteSpace(siteSettings?.SchoolName)
        ? "School Blog Project"
        : siteSettings!.SchoolName;
    string schoolAcronym = string.IsNullOrWhiteSpace(siteSettings?.SchoolAcronym)
        ? "School"
        : siteSettings!.SchoolAcronym;
    string schoolBlurb = string.IsNullOrWhiteSpace(siteSettings?.SchoolBlurb)
        ? "Placeholder blurb about the school and the blog."
        : siteSettings!.SchoolBlurb;
    string schoolLogo = string.IsNullOrWhiteSpace(siteSettings?.SchoolLogo)
        ? "/images/placeholder-logo.svg"
        : siteSettings!.SchoolLogo;
    string schoolEmblem = string.IsNullOrWhiteSpace(siteSettings?.SchoolEmblem)
        ? "/images/placeholder-emblem.svg"
        : siteSettings!.SchoolEmblem;
    int establishedYear = siteSettings?.StartYear > 0 ? siteSettings.StartYear : DateTime.UtcNow.Year;
    string primaryColor = string.IsNullOrWhiteSpace(siteSettings?.ColorScheme?.Color1)
        ? "#0D6EFD"
        : $"#{siteSettings!.ColorScheme!.Color1.ToUpperInvariant()}";
    string secondaryColor = string.IsNullOrWhiteSpace(siteSettings?.ColorScheme?.Color2)
        ? "#F5A623"
        : $"#{siteSettings!.ColorScheme!.Color2.ToUpperInvariant()}";
    string tertiaryColor = "#FFFFFF";
    IReadOnlyList<OffSiteLink> footerLinks = siteSettings?.OffSiteLinks
        .OrderBy(link => link.Name)
        .ToList() ?? [];
}
<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Basic document metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @schoolName</title>
    <script type="importmap"></script>

    <!-- Shared application styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/School_Blog_project.styles.css" asp-append-version="true" />
    <style>
        :root {
            --site-primary: @primaryColor;
            --site-secondary: @secondaryColor;
            --site-tertiary: @tertiaryColor;
        }
    </style>
    <script>
        (function () {
            function applySavedColors() {
                try {
                    const primary = localStorage.getItem('primaryColor');
                    const secondary = localStorage.getItem('secondaryColor');
                    const tertiary = localStorage.getItem('tertiaryColor');

                    if (primary) {
                        document.documentElement.style.setProperty('--site-primary', primary);
                    }

                    if (secondary) {
                        document.documentElement.style.setProperty('--site-secondary', secondary);
                    }

                    if (tertiary) {
                        document.documentElement.style.setProperty('--site-tertiary', tertiary);
                    }
                } catch (error) {
                    console.warn('Unable to apply saved site colors.', error);
                }
            }

            function applyPageSurfaceClasses() {
                const main = document.querySelector('main[role="main"]');
                if (main && window.location.pathname.toLowerCase().startsWith('/identity/account/')) {
                    main.classList.add('site-auth-page');
                }
            }

            document.addEventListener('DOMContentLoaded', applyPageSurfaceClasses);

            window.applySavedColors = applySavedColors;
            applySavedColors();
        })();
    </script>
</head>
<body>
    <!-- Site header and primary navigation -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3 site-navbar">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-semibold" asp-area="" asp-controller="Home" asp-action="Index" aria-label="@schoolName home">
                    <img src="@schoolLogo" alt="@schoolName logo" class="site-logo rounded" />
                    <span>@schoolAcronym</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Main navigation links and shared login partial -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Students">Student Stories</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Graduates">Graduate Stories</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Faculty">Faculty &amp; Staff Stories</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="News">News</a>
                        </li>
                    </ul>

                    <!-- Authentication UI shared across the application -->
                    <partial name="_LoginPartial" />

                    <!-- Non-functional search input (placeholder only) -->
                    <form class="d-flex ms-3" role="search" onsubmit="return false;">
                        <input class="form-control" type="search" placeholder="Search" aria-label="Search" />
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main page content -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Site footer with branding, links, and blurb -->
    <footer class="border-top footer text-muted">
        <div class="container py-4">
            <div class="row align-items-start g-4">
                <div class="col-12 col-md-2 mb-3 text-center text-md-start">
                    <img src="@schoolEmblem" alt="@schoolName emblem" class="site-emblem rounded-circle" />
                    <div class="mt-3 fw-semibold text-dark">@schoolName</div>
                    <div class="small text-muted">Established @establishedYear</div>
                </div>

                <div class="col-12 col-md-7 mb-3">
                    <div class="row">
                        <div class="col-12 col-sm-6 mb-3">
                            <h5>More About @schoolAcronym</h5>
                            @if (footerLinks.Count > 0)
                            {
                                <ul class="list-unstyled site-footer-links">
                                    @foreach (OffSiteLink link in footerLinks)
                                    {
                                        <li><a class="text-decoration-none text-muted" href="@link.URL" target="_blank" rel="noopener noreferrer">@link.Name</a></li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted small mb-0">No off-site links have been configured yet.</p>
                            }
                        </div>

                        <div class="col-12 col-sm-6 mb-3">
                            <h5>Categories</h5>
                            <ul class="list-unstyled">
                                <li><a class="text-decoration-none text-muted" asp-area="" asp-controller="Home" asp-action="Students">Student Stories</a></li>
                                <li><a class="text-decoration-none text-muted" asp-area="" asp-controller="Home" asp-action="Graduates">Graduate Stories</a></li>
                                <li><a class="text-decoration-none text-muted" asp-area="" asp-controller="Home" asp-action="Faculty">Faculty &amp; Staff Stories</a></li>
                                <li><a class="text-decoration-none text-muted" asp-area="" asp-controller="Home" asp-action="News">News</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-3 mb-3">
                    <p class="text-muted small">@schoolBlurb</p>
                    <div class="mt-3">
                        @await Html.PartialAsync("_MediaContact")
                    </div>
                </div>
            </div>
        </div>

        <div class="site-footer-accent text-white">
            <div class="w-100 text-center py-2 small">
                &copy; @DateTime.UtcNow.Year - @schoolName
            </div>
        </div>
    </footer>

    <!-- Shared client-side scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
