@model SchoolBlogProject.Models.HomePageArticleViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <div class="row">
        <div class="col-12 col-lg-10 mx-auto">
            <article class="border rounded p-3">
                <img src="@Model.ImageUrl"
                     alt="@Model.Title"
                     class="img-fluid rounded mb-3 w-100" />

                <h1 class="h3 mb-2">@Model.Title</h1>
                <p class="text-muted mb-4">@Model.DatePublished.ToString("MMM d, yyyy")</p>

                <div class="border rounded bg-light" style="min-height: 18rem;" aria-label="Article body placeholder"></div>
            </article>
        </div>
    </div>
</div>